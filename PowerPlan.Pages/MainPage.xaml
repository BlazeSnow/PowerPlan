<?xml version="1.0" encoding="UTF-8"?>
<Page
    x:Class="PowerPlan.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SettingsCardHeaderIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Background="Transparent">
            <StackPanel Padding="24" Spacing="16">
            <controls:SettingsCard x:Name="UltimateCard" Visibility="Collapsed">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon x:Name="UltimateCardIcon" Glyph="&#xE945;" Style="{StaticResource SettingsCardHeaderIconStyle}" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    x:Name="CreateUltimateButton"
                    Click="OnCreateUltimateClicked"
                    Content="-"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
            </controls:SettingsCard>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Padding="0">
                <StackPanel>
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PlanPickerTitleText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="-" />
                    </Grid>

                    <ListView
                        x:Name="PlansListView"
                        ItemsSource="{Binding Plans}"
                        SelectionMode="Single"
                        SelectionChanged="OnPlansSelectionChanged"
                        BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0" Padding="16,12">
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton
                                            Grid.Column="0"
                                            IsChecked="{Binding IsActive, Mode=OneWay}"
                                            IsHitTestVisible="False"
                                            MinWidth="0"
                                            Padding="0"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                FontSize="13"
                                                Opacity="0.75"
                                                VerticalAlignment="Center"
                                                Text="{Binding Guid}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            Content="{Binding CopyButtonText}"
                                            Tag="{Binding Guid}"
                                            Click="OnCopyPlanClicked"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Padding="16,12" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="RefreshPlansButton"
                            Click="OnRefreshClicked"
                            Content="-"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            x:Name="DeletePlanHintText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Opacity="0.75"
                            Text="-" />
                    </Grid>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Closed="OnStatusInfoBarClosed"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational"
            Margin="24,0,24,24" />
    </Grid>
</Page>
